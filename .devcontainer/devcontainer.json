{
  "name": "Heltec V4 GitHub Build Environment",
  "image": "ghcr.io/meshtastic/gh-action-firmware@sha256:60557028c9ad6c4aa8580fb29d5c99874792cbff8c4703c6dfeccf1c263376b3",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "remoteUser": "root",
  "overrideCommand": true,
  "mounts": [
    "source=heltec-v4-devcontainer-pio,target=/workspace/.pio,type=volume",
    "source=heltec-v4-devcontainer-core,target=/pio/core,type=volume",
    "source=heltec-v4-devcontainer-workspace,target=/pio/workspace,type=volume"
  ],
  "containerEnv": {
    "HELTEC_DEVCONTAINER": "1",
    "PLATFORMIO_BUILD_DIR": "/workspace/.pio/build",
    "GIT_CONFIG_COUNT": "2",
    "GIT_CONFIG_KEY_0": "safe.directory",
    "GIT_CONFIG_VALUE_0": "/workspace",
    "GIT_CONFIG_KEY_1": "safe.directory",
    "GIT_CONFIG_VALUE_1": "/workspace/protobufs"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.cpptools", "Jason2866.esp-decoder", "Trunk.io"],
      "unwantedRecommendations": [
        "ms-azuretools.vscode-docker",
        "pioarduino.pioarduino-ide",
        "platformio.platformio-ide"
      ],
      "settings": {
        "extensions.ignoreRecommendations": true
      }
    }
  },
  "postCreateCommand": ["git", "submodule", "update", "--init", "--recursive"]
}
